[Unit]
Description=Knotworking Python (Piezo -> OSC)
After=knotworking-sc.service
Requires=knotworking-sc.service

[Service]
Type=simple
User=knotworking
WorkingDirectory=/home/knotworking/Knotworking

# Warten, bis SuperCollider (das selbst 30s wartet + ~20s Hochfahren)
# vollstaendig bereit ist, BEVOR Python startet.
ExecStartPre=/bin/sleep 55

ExecStart=/usr/bin/python3 /home/knotworking/Knotworking/knotworking_dual.py

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

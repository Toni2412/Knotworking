[Unit]
Description=Knotworking SuperCollider (sclang + startup.scd)
# NUR nach sound/network - NICHT multi-user.target (das erzeugt einen Zyklus!)
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=knotworking
WorkingDirectory=/home/knotworking/Knotworking

Environment=QT_QPA_PLATFORM=offscreen
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Beim Booten warten, bis die USB-Audiokarte sicher bereit ist
ExecStartPre=/bin/sleep 30

ExecStart=/usr/bin/sclang /home/knotworking/Knotworking/startup.scd

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

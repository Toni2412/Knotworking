[Unit]
Description=Knotworking SuperCollider (sclang + startup.scd)
# Warten bis Netzwerk und Sound-System initialisiert sind
After=sound.target network.target multi-user.target
Wants=sound.target

[Service]
Type=simple
User=knotworking
WorkingDirectory=/home/knotworking/Knotworking

Environment=QT_QPA_PLATFORM=offscreen
Environment=XDG_RUNTIME_DIR=/run/user/1000

# WICHTIG: beim Booten warten, bis die USB-Audiokarte sicher bereit ist.
# Beim manuellen Start war sie laengst da - beim Booten ist es ein Wettrennen.
ExecStartPre=/bin/sleep 30

ExecStart=/usr/bin/sclang /home/knotworking/Knotworking/startup.scd

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
